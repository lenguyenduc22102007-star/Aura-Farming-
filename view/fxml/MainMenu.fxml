<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: #87CEEB;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="view.screen_controller.MainMenuController">
    <children>
        <VBox alignment="CENTER" spacing="16">
            <padding>
                <Insets topRightBottomLeft="40" />
            </padding>
            <children>
                <Label styleClass="plaque, title-xl" text="SMART  FARM" />
                <Label styleClass="subtitle-chip" text="Pixel Farm Simulator — JavaFX Edition" />
                <Region minHeight="18" />

                <Button fx:id="btnContinue" onAction="#onContinue" styleClass="btn-menu" text="CONTINUE  CURRENT  FARM" />
                <Button fx:id="btnStartNewGame" onAction="#onStartNew" styleClass="btn-menu" text="START  NEW  FARM" />
                <Button fx:id="btnHelp" onAction="#onHelp" styleClass="btn-menu" text="HELP" />
                <Button fx:id="btnQuit" onAction="#onQuit" styleClass="btn-menu" text="QUIT" />
            </children>
        </VBox>
    </children>
</StackPane>
