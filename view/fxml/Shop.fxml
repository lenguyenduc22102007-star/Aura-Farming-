<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="720" prefWidth="1280" styleClass="shop-root" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="view.screen_controller.ShopViewController">

    <top>

        <StackPane BorderPane.alignment="CENTER">

            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>

            <Label style="-fx-font-size: 36;                           -fx-font-weight: bold;" styleClass="shop-title" text="SHOP" />

        </StackPane>

    </top>

    <center>

        <VBox alignment="TOP_CENTER" spacing="20">

            <padding>
                <Insets bottom="10" left="30" right="30" top="10" />
            </padding>

            <TabPane prefHeight="500" prefWidth="950" styleClass="shop-tabs" tabClosingPolicy="UNAVAILABLE">

                <tabs>

                    <Tab text="Seeds">

                        <content>

                            <FlowPane fx:id="seedPane" hgap="20" prefHeight="500" prefWidth="900" styleClass="shop-flow" vgap="20">

                                <padding>
                                    <Insets bottom="20" left="20" right="20" top="20" />
                                </padding>

                            </FlowPane>

                        </content>

                    </Tab>

                    <Tab text="Fertilizer">

                        <content>

                            <FlowPane fx:id="fertilizerPane" hgap="20" prefHeight="500" prefWidth="900" styleClass="shop-flow" vgap="20">

                                <padding>
                                    <Insets bottom="20" left="20" right="20" top="20" />
                                </padding>

                            </FlowPane>

                        </content>

                    </Tab>

                    <Tab text="Animals">

                        <content>

                            <FlowPane fx:id="animalPane" hgap="20" prefHeight="500" prefWidth="900" styleClass="shop-flow" vgap="20">

                                <padding>
                                    <Insets bottom="20" left="20" right="20" top="20" />
                                </padding>

                            </FlowPane>

                        </content>

                    </Tab>

                </tabs>

            </TabPane>

        </VBox>

    </center>

    <bottom>

        <HBox alignment="CENTER" maxHeight="-Infinity" minHeight="-Infinity" prefHeight="70.0" spacing="20" styleClass="shop-bottom" BorderPane.alignment="CENTER">

            <padding>
                <Insets bottom="15" left="30" right="30" top="15" />
            </padding>

            <Label fx:id="moneyLabel" style="-fx-font-size: 24;                           -fx-font-weight: bold;" styleClass="shop-money" text="\$200" />

            <Pane HBox.hgrow="ALWAYS" />

            <HBox alignment="CENTER" spacing="10">

                <Label fx:id="statusLabel" style="-fx-font-size: 20;" styleClass="shop-status" text="Welcome to the Shop!" />

            </HBox>

            <Pane minHeight="-Infinity" prefHeight="50.0" HBox.hgrow="ALWAYS" />

            <Button onAction="#backToGame" prefHeight="40" prefWidth="100" styleClass="shop-back-btn" text="BACK" />

        </HBox>

    </bottom>

</BorderPane>
