<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane fx:id="rootPane" styleClass="ingame-root" prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="view.screen_controller.InGameController">

   <!-- ====================================================== -->
   <!-- TOP BAR -->
   <!-- ====================================================== -->

   <top>

      <HBox styleClass="top-bar" alignment="CENTER_LEFT" spacing="10" visible="false" managed="false">

         <padding>
            <Insets bottom="12" left="12" right="12" top="12" />
         </padding>

         <Label fx:id="toolLabel" prefHeight="28.0" prefWidth="340.0" text="TOOL : STANDARD FERTILIZER">

            <font>
               <Font name="Segoe UI Bold" size="22" />
            </font>

         </Label>
         <HBox prefHeight="28.0" prefWidth="150.0" />

         <TextField fx:id="notificationField" styleClass="notification-field" editable="false" maxWidth="-Infinity" prefWidth="400.0" text="Game notification..." HBox.hgrow="ALWAYS" />

      </HBox>

   </top>


   <!-- ====================================================== -->
   <!-- CENTER GAME GRID -->
   <!-- ====================================================== -->

   <center>

      <StackPane>

         <padding>
            <Insets bottom="20" left="20" right="20" top="20" />
         </padding>

         <GridPane fx:id="farmGrid" styleClass="farm-grid" alignment="CENTER" hgap="4" vgap="4" />

         <!-- Weather mood wash over the play field; clicks pass straight through. -->
         <Pane fx:id="weatherOverlay" styleClass="weather-overlay" mouseTransparent="true" />

      </StackPane>

   </center>


   <!-- ====================================================== -->
   <!-- RIGHT PANEL -->
   <!-- ====================================================== -->

   <right>

      <VBox styleClass="right-panel" alignment="TOP_CENTER" prefWidth="184" spacing="10">

         <padding>
            <Insets bottom="12" left="12" right="12" top="12" />
         </padding>


         <!-- DAY -->

         <TextField fx:id="dayField" styleClass="side-display" alignment="CENTER" editable="false" text="DAY 1" />


         <!-- WEATHER SELECT -->

         <VBox alignment="CENTER" spacing="6">

            <ToggleButton fx:id="sunWeatherButton" styleClass="weather-btn" mnemonicParsing="false" prefHeight="42" prefWidth="104" text="SUN">

               <toggleGroup>
                  <ToggleGroup fx:id="weatherGroup" />
               </toggleGroup>

            </ToggleButton>


            <ToggleButton fx:id="rainWeatherButton" styleClass="weather-btn" mnemonicParsing="false" prefHeight="42" prefWidth="104" text="RAIN" toggleGroup="$weatherGroup" />


            <ToggleButton fx:id="dryWeatherButton" styleClass="weather-btn" mnemonicParsing="false" prefHeight="42" prefWidth="104" text="DRY" toggleGroup="$weatherGroup" />

         </VBox>


         <!-- MONEY -->

         <StackPane styleClass="money-box">

            <Label
                    fx:id="moneyField"
                    alignment="CENTER"
                    prefHeight="52"
                    prefWidth="126"
                    text="\$200"
                    styleClass="money-label"
            />

         </StackPane>

         <!-- NÚT MỞ CUỐN SỔ QUẢN LÝ 5 TAB (Phím TAB) -->

         <Button fx:id="fishingGuideButton" mnemonicParsing="false" focusTraversable="false" minWidth="-Infinity" onAction="#openGameBookDefault" prefHeight="34" prefWidth="162" text="📖 SỔ QUẢN LÝ [TAB]" style="-fx-font-family: 'Consolas', monospace; -fx-font-size: 11.5px; -fx-font-weight: bold; -fx-text-fill: #FFF4D2; -fx-padding: 4 8 4 8; -fx-background-color: linear-gradient(to bottom, #9A5E31 0%, #6D3E1C 100%); -fx-border-color: #3B1E0A; -fx-border-width: 2.5px; -fx-background-radius: 8px; -fx-border-radius: 8px; -fx-cursor: hand;" />

         <!-- BẢNG CHUỖI 1000 NHIỆM VỤ TỰ ĐỘNG (QUEST TRACKER - Bấm vào để mở Tab Nhiệm Vụ) -->

         <VBox fx:id="questTrackerBox" onMouseClicked="#openBookQuests" alignment="TOP_LEFT" prefWidth="162" spacing="5" style="-fx-background-color: linear-gradient(to bottom, #F8E7C6 0%, #E8CE9F 100%); -fx-border-color: #6B3C1A; -fx-border-width: 2.5px; -fx-background-radius: 9px; -fx-border-radius: 9px; -fx-padding: 8 9 9 9; -fx-cursor: hand;">

            <Label fx:id="questTitleLabel" text="NHIỆM VỤ #1" style="-fx-font-family: 'Consolas', monospace; -fx-font-size: 11.5px; -fx-font-weight: bold; -fx-text-fill: #6B2A0C;" />

            <Label fx:id="questDescLabel" wrapText="true" maxWidth="142" text="Thu hoạch 2 Cà chua" style="-fx-font-family: 'Consolas', monospace; -fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #3E210C;" />

            <Label fx:id="questProgressLabel" text="Tiến độ: 0 / 2" style="-fx-font-family: 'Consolas', monospace; -fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #1F5C3A;" />

            <Label fx:id="questRewardLabel" text="Thưởng: +$105" style="-fx-font-family: 'Consolas', monospace; -fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #9A5212;" />

            <Button fx:id="questClaimButton" mnemonicParsing="false" focusTraversable="false" onAction="#onClaimQuestReward" prefHeight="28" prefWidth="142" text="🎁 Nhận Thưởng" visible="false" managed="false" style="-fx-font-family: 'Consolas', monospace; -fx-font-size: 11.5px; -fx-font-weight: bold; -fx-text-fill: #2B1200; -fx-background-color: linear-gradient(to bottom, #FFE066 0%, #F5A623 100%); -fx-border-color: #8A4F00; -fx-border-width: 2px; -fx-background-radius: 7px; -fx-border-radius: 7px; -fx-cursor: hand;" />

         </VBox>

      </VBox>

   </right>


   <!-- ====================================================== -->
   <!-- BOTTOM PANEL -->
   <!-- ====================================================== -->

   <bottom>

      <HBox alignment="CENTER_LEFT" styleClass="bottom-bar" prefHeight="108.0" prefWidth="1280.0" spacing="30">

         <padding>
            <Insets bottom="15" left="15" right="15" top="15" />
         </padding>


         <!-- ================================================== -->
         <!-- STATUS DASHBOARD -->
         <!-- ================================================== -->

         <VBox fx:id="soilStatusPanel" styleClass="status-panel" prefHeight="100.0" prefWidth="320.0" spacing="8" visible="false">

            <HBox spacing="15">

               <Label fx:id="cellLabel" text="CELL : 4,4">

                  <font>
                     <Font name="Consolas Bold" size="16" />
                  </font>

               </Label>


               <Label fx:id="waterLabel" text="WATER : 40">

                  <font>
                     <Font name="Consolas Bold" size="16" />
                  </font>

               </Label>


               <Label fx:id="nutrientLabel" text="NUTR : 50">

                  <font>
                     <Font name="Consolas Bold" size="16" />
                  </font>

               </Label>

            </HBox>


            <Label fx:id="cropLabel" text="CROP : NONE">

               <font>
                  <Font name="Consolas Bold" size="16" />
               </font>

            </Label>

         </VBox>


         <!-- SPACER -->

         <HBox HBox.hgrow="ALWAYS" />


         <!-- ================================================== -->
         <!-- TOOL HOTBAR -->
         <!-- ================================================== -->

         <HBox styleClass="tool-hotbar" alignment="CENTER" spacing="10">

            <ToggleButton fx:id="seedTool" mnemonicParsing="false" prefHeight="70" prefWidth="70" text="SEED">

               <toggleGroup>
                  <ToggleGroup fx:id="toolGroup" />
               </toggleGroup>

            </ToggleButton>


            <ToggleButton fx:id="hoeTool" mnemonicParsing="false" prefHeight="70" prefWidth="70" text="HOE" toggleGroup="$toolGroup" />


            <ToggleButton fx:id="waterTool" mnemonicParsing="false" prefHeight="70" prefWidth="70" text="WATER" toggleGroup="$toolGroup" />


            <ToggleButton fx:id="handTool" mnemonicParsing="false" prefHeight="70" prefWidth="70" text="HAND" toggleGroup="$toolGroup" />


            <ToggleButton fx:id="fertilizerTool" mnemonicParsing="false" prefHeight="70" prefWidth="70" text="FERTZ" toggleGroup="$toolGroup" />


            <ToggleButton fx:id="bagTool" mnemonicParsing="false" prefHeight="70" prefWidth="70" text="BAG" toggleGroup="$toolGroup" />

         </HBox>


         <!-- SPACER -->

         <HBox HBox.hgrow="ALWAYS" />


         <!-- ================================================== -->
         <!-- CỤM NÚT GỌN MỞ NHANH CUỐN SỔ & QUA NGÀY -->
         <!-- ================================================== -->

         <VBox styleClass="action-panel" alignment="CENTER" spacing="8">

            <HBox alignment="CENTER" spacing="6">
               <Button fx:id="storageButton" focusTraversable="false" minWidth="-Infinity" mnemonicParsing="false" onAction="#openStorageMenu" prefHeight="36" text="Kho" style="-fx-font-family: 'Consolas', monospace; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 4 10 4 10;" />
               <Button fx:id="shopButton" focusTraversable="false" minWidth="-Infinity" mnemonicParsing="false" onAction="#openShop" prefHeight="36" text="Shop" style="-fx-font-family: 'Consolas', monospace; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 4 10 4 10;" />
               <Button focusTraversable="false" minWidth="-Infinity" mnemonicParsing="false" onAction="#toggleFishingGuide" prefHeight="36" text="Sổ Cá" style="-fx-font-family: 'Consolas', monospace; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 4 10 4 10;" />
               <Button focusTraversable="false" minWidth="-Infinity" mnemonicParsing="false" onAction="#openBookSettings" prefHeight="36" text="⚙" style="-fx-font-family: 'Consolas', monospace; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 4 10 4 10;" />
            </HBox>

            <Button fx:id="nextDayButton" focusTraversable="false" minWidth="-Infinity" mnemonicParsing="false" onAction="#onNextDay" prefHeight="38" prefWidth="216" text="☀ QUA NGÀY MỚI" style="-fx-font-family: 'Consolas', monospace; -fx-font-size: 12.5px; -fx-font-weight: bold; -fx-padding: 4 12 4 12;" />

         </VBox>

      </HBox>

   </bottom>

</BorderPane>
